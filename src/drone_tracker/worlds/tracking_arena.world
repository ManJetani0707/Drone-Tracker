<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tracking_arena">

    <!-- Physics -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.65 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 -0.4 0.5</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena boundary walls (low, for visual reference) -->
    <model name="wall_north">
      <static>true</static>
      <pose>20 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 40 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 40 1</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>-20 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 40 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 40 1</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>0 20 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>40 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>40 0.2 1</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>0 -20 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>40 0.2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>40 0.2 1</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Obstacles for target occlusion testing -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>5 5 1 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 1 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2 1 2</size></box></geometry>
          <material><script><name>Gazebo/WoodFloor</name></script></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_2">
      <static>true</static>
      <pose>-6 3 1.5 0 0 -0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 3 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 3 3</size></box></geometry>
          <material><script><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Drone model (simple box proxy — replace with proper mesh) -->
    <model name="drone_model">
      <pose>0 -12 5 0 0 1.5707963</pose>
      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz></inertia>
        </inertial>
        <!-- Body -->
        <visual name="body">
          <geometry><box><size>0.35 0.35 0.12</size></box></geometry>
          <material><script><name>Gazebo/DarkGrey</name></script></material>
        </visual>
        <!-- Camera mount (front) -->
        <visual name="cam">
          <pose>0.18 0 -0.03 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <!-- 4 rotors (simple discs) -->
        <visual name="r1">
          <pose>0.18  0.18 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="r2">
          <pose>-0.18  0.18 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="r3">
          <pose>0.18 -0.18 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
        <visual name="r4">
          <pose>-0.18 -0.18 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
        <!-- Camera sensor -->
        <sensor name="front_camera" type="camera">
          <pose>0.2 0 -0.03 0 0 0</pose>
          <camera>
            <horizontal_fov>1.5708</horizontal_fov><!-- 90° -->
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>200</far></clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/drone</namespace>
              <remapping>image_raw:=camera/image_raw</remapping>
              <remapping>camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>front_camera</camera_name>
            <frame_name>drone_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Walking actor (the target) -->
    <actor name="walking_actor">
      <pose>8 0 0 0 0 0</pose>
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <!-- Circular walking path, radius 8 m -->
        <trajectory id="0" type="walking">
          <waypoint><time>0</time>  <pose>8   0   0 0 0  1.5708</pose></waypoint>
          <waypoint><time>13</time> <pose>0   8   0 0 0  3.1416</pose></waypoint>
          <waypoint><time>26</time> <pose>-8  0   0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>39</time> <pose>0  -8   0 0 0  0.0</pose></waypoint>
          <waypoint><time>52</time> <pose>8   0   0 0 0  1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ROS plugins -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

  </world>
</sdf>
